{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "AppSettings": {
    "ApprovalBaseUrl": "https://placeholder-set-via-env-var.vercel.app/approve"
  },
  "WorkshopSettings": {
    "PhysicalCapacity": 6
  },
  "JwtSettings": {
    "Issuer": "MyCarBE",
    "Audience": "MyCarBE",
    "ExpirationInMinutes": 60
  },
  "EmailSettings": {
    "Host": "dtc027.ferozo.com",
    "Port": "465",
    "From": "gbservice@armeniotuc.com",
    "User": "gbservice@armeniotuc.com",
    "FromName": "GB Service"
  }
}
